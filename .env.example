# Free API key from Google AI Studio: https://aistudio.google.com/apikey
# (sign in with a Google account, no credit card required)
GEMINI_API_KEY=

# Optional: override the model used for chat/call replies
GEMINI_MODEL=gemini-2.5-flash

# Required for calling (used to transcribe your voice). Also used for
# natural, human-sounding reply voices if selected in the profile editor.
# Get a free-tier key at https://elevenlabs.io/ (Developers -> API Keys).
# Give it "Speech to Text" and "Voices" permissions, not just Text to Speech.
ELEVENLABS_API_KEY=

# Optional: override the ElevenLabs TTS model
ELEVENLABS_MODEL=eleven_turbo_v2_5

# Optional: override the ElevenLabs speech-to-text model
ELEVENLABS_STT_MODEL=scribe_v1
