# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the model used for chat/call replies
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: for natural, human-sounding call voices via ElevenLabs.
# Get a free-tier key at https://elevenlabs.io/ (Profile -> API Keys).
# Leave blank to use the browser's built-in text-to-speech instead.
ELEVENLABS_API_KEY=

# Optional: override the ElevenLabs TTS model
ELEVENLABS_MODEL=eleven_turbo_v2_5
